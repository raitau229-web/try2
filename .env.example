# ローカル開発時に共通APIキーを試したい場合は .env.local にコピーして値を設定してください。
# (.env.local はGit管理外です。本番用の値はGitHub Actionsのsecretsに設定します)
VITE_GOOGLE_MAPS_API_KEY=
VITE_GEMINI_API_KEY=

# 旅程の共有・検索・いいね機能に使用するSupabaseプロジェクト。
# Project Settings > API の Project URL と anon (publishable) key を設定してください。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
